import { prisma } from '../../lib/prisma';
import { LotStatus } from '@prisma/client';

export const createLot = async (sellerId: string, data: any) => {
  const { title, description, price, quantity, autoDelivery, autoDeliveryData, deliveryMethod, activationSchedule, excludedDates } = data;
  return await prisma.lot.create({
    data: {
      sellerId,
      title,
      description,
      price,
      quantity,
      autoDelivery: autoDelivery || false,
      autoDeliveryData,
      deliveryMethod,
      activationSchedule,
      excludedDates: excludedDates || [],
      isActive: true,
      status: 'ACTIVE',
    },
  });
};

export const updateLot = async (lotId: string, userId: string, data: any) => {
  const lot = await prisma.lot.findUnique({ where: { id: lotId } });
  if (!lot) throw new Error('Lot not found');
  if (lot.sellerId !== userId) throw new Error('Forbidden');

  const { title, description, price, quantity, autoDelivery, autoDeliveryData, deliveryMethod, activationSchedule, excludedDates, isActive } = data;
  return await prisma.lot.update({
    where: { id: lotId },
    data: {
      title,
      description,
      price,
      quantity,
      autoDelivery,
      autoDeliveryData,
      deliveryMethod,
      activationSchedule,
      excludedDates,
      isActive,
    },
  });
};

export const getLotsWithFilters = async (filters: any) => {
  const { minPrice, maxPrice, minQuantity, maxQuantity, autoDelivery, isActive, search } = filters;
  const where: any = {};
  if (minPrice !== undefined) where.price = { gte: minPrice };
  if (maxPrice !== undefined) where.price = { ...where.price, lte: maxPrice };
  if (minQuantity !== undefined) where.quantity = { gte: minQuantity };
  if (maxQuantity !== undefined) where.quantity = { ...where.quantity, lte: maxQuantity };
  if (autoDelivery !== undefined) where.autoDelivery = autoDelivery;
  if (isActive !== undefined) where.isActive = isActive;
  if (search) where.title = { contains: search, mode: 'insensitive' };
  return await prisma.lot.findMany({
    where,
    orderBy: { createdAt: 'desc' },
  });
};
EOF

