1. Dockerfile для бэкенда (Node.js)

Создайте server/Dockerfile:
dockerfile

# Используем официальный LTS-образ Node.js
FROM node:20-alpine AS builder

WORKDIR /app

# Копируем package.json и lock-файлы
COPY package*.json ./
COPY prisma ./prisma/

# Устанавливаем зависимости (включая dev-зависимости для сборки)
RUN npm ci

# Копируем исходники
COPY . .

# Генерируем Prisma Client
RUN npx prisma generate

# Сборка TypeScript (если используете)
RUN npm run build

# ---- Второй этап: минимальный образ для запуска ----
FROM node:20-alpine AS runner

WORKDIR /app

# Копируем только нужные файлы из билдера
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY package*.json ./

# Устанавливаем только production-зависимости (если нужно)
# RUN npm ci --omit=dev

# Открываем порт (у Fastify по умолчанию 3000)
EXPOSE 3000

# Запускаем приложение
CMD ["node", "dist/index.js"]

    Примечание: Если вы используете Prisma миграции при старте, можно добавить npx prisma migrate deploy перед запуском, но обычно миграции запускаются отдельно.

2. Docker Compose (основной файл)

Создайте docker-compose.yml в корне проекта:
yaml

version: '3.8'

services:
  # --------------------- Бэкенд ---------------------
  app:
    build:
      context: ./server
      dockerfile: Dockerfile
    container_name: my-app
    restart: unless-stopped
    environment:
      - NODE_ENV=development
      - PORT=3000
      - DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}
      - REDIS_URL=redis://redis:6379
      # другие переменные (JWT_SECRET, и т.д.)
    env_file:
      - .env
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - app-network
    volumes:
      - ./server:/app          # для разработки (живая перезагрузка)
      - /app/node_modules      # скрываем node_modules, чтобы не перезаписывались
    # Если используете nodemon для hot-reload:
    # command: npm run dev

  # --------------------- PostgreSQL ---------------------
  postgres:
    image: postgres:15-alpine
    container_name: my-postgres
    restart: unless-stopped
    environment:
      - POSTGRES_USER=${DB_USER}
      - POSTGRES_PASSWORD=${DB_PASSWORD}
      - POSTGRES_DB=${DB_NAME}
    ports:
      - "5432:5432"   # пробрасываем на хост для удобства
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./init-db.sql:/docker-entrypoint-initdb.d/init.sql  # опционально
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER} -d ${DB_NAME}"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - app-network

  # --------------------- Redis ---------------------
  redis:
    image: redis:7-alpine
    container_name: my-redis
    restart: unless-stopped
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    command: redis-server --appendonly yes --requirepass ${REDIS_PASSWORD}   # если нужен пароль
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - app-network

  # --------------------- Nginx (reverse proxy) ---------------------
  nginx:
    image: nginx:alpine
    container_name: my-nginx
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"   # для HTTPS позже
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./static:/usr/share/nginx/html   # если есть статика
    depends_on:
      - app
    networks:
      - app-network

# Сети и тома
networks:
  app-network:
    driver: bridge

volumes:
  postgres_data:
  redis_data:

