Шаг 4: Создай app.js (вся логика)
bash

cat > app.js << 'EOF'
const API_BASE = 'http://localhost:3000';
let token = null;
let userId = null;

// DOM элементы
const userStatus = document.getElementById('user-status');
const logoutBtn = document.getElementById('logout-btn');
const registerForm = document.getElementById('register-form');
const loginForm = document.getElementById('login-form');
const createLotForm = document.getElementById('create-lot-form');
const orderForm = document.getElementById('order-form');
const lotsContainer = document.getElementById('lots-container');

// Вспомогательные функции
function showMessage(element, text, type = 'success') {
  element.innerHTML = `<div class="message ${type}">${text}</div>`;
}

// Проверка авторизации
function setAuthState(tok, uid) {
  token = tok;
  userId = uid;
  if (token) {
    userStatus.textContent = `Пользователь ${uid}`;
    logoutBtn.style.display = 'inline-block';
    document.getElementById('create-lot-section').style.display = 'block';
    document.getElementById('order-section').style.display = 'block';
    document.getElementById('register-section').style.display = 'none';
    document.getElementById('login-section').style.display = 'none';
  } else {
    userStatus.textContent = 'Не авторизован';
    logoutBtn.style.display = 'none';
    document.getElementById('create-lot-section').style.display = 'none';
    document.getElementById('order-section').style.display = 'none';
    document.getElementById('register-section').style.display = 'block';
    document.getElementById('login-section').style.display = 'block';
  }
}

// Регистрация
registerForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  const email = document.getElementById('reg-email').value;
  const password = document.getElementById('reg-password').value;
  try {
    const res = await fetch(`${API_BASE}/auth/register`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password })
    });
    const data = await res.json();
    if (res.ok) {
      showMessage(document.getElementById('register-message'), 'Регистрация успешна! Теперь войдите.', 'success');
    } else {
      showMessage(document.getElementById('register-message'), data.error || 'Ошибка регистрации', 'error');
    }
  } catch (err) {
    showMessage(document.getElementById('register-message'), 'Ошибка сети', 'error');
  }
});

// Логин
loginForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  const email = document.getElementById('login-email').value;
  const password = document.getElementById('login-password').value;
  try {
    const res = await fetch(`${API_BASE}/auth/login`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password })
    });
    const data = await res.json();
    if (res.ok) {
      setAuthState(data.token, data.user.id);
      showMessage(document.getElementById('login-message'), 'Вход выполнен!', 'success');
      loadLots();
    } else {
      showMessage(document.getElementById('login-message'), data.error || 'Ошибка входа', 'error');
    }
  } catch (err) {
    showMessage(document.getElementById('login-message'), 'Ошибка сети', 'error');
  }
});

// Выход
logoutBtn.addEventListener('click', () => {
  setAuthState(null, null);
  window.location.reload();
});

// Создание лота
createLotForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (!token) {
    showMessage(document.getElementById('create-lot-message'), 'Сначала войдите', 'error');
    return;
  }
  const title = document.getElementById('lot-title').value;
  const price = parseFloat(document.getElementById('lot-price').value);
  const quantity = parseInt(document.getElementById('lot-quantity').value);
  const autoDelivery = document.getElementById('lot-autodelivery').checked;
  const autoDeliveryData = document.getElementById('lot-autodelivery-data').value;

  try {
    const res = await fetch(`${API_BASE}/api/lots`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      },
      body: JSON.stringify({ title, price, quantity, autoDelivery, autoDeliveryData })
    });
    const data = await res.json();
    if (res.ok) {
      showMessage(document.getElementById('create-lot-message'), 'Лот создан!', 'success');
      loadLots();
    } else {
      showMessage(document.getElementById('create-lot-message'), data.error || 'Ошибка', 'error');
    }
  } catch (err) {
    showMessage(document.getElementById('create-lot-message'), 'Ошибка сети', 'error');
  }
});

// Загрузка лотов
async function loadLots() {
  try {
    const res = await fetch(`${API_BASE}/api/lots`);
    const data = await res.json();
    if (res.ok) {
      if (data.length === 0) {
        lotsContainer.innerHTML = '<p>Нет доступных лотов</p>';
        return;
      }
      lotsContainer.innerHTML = data.map(lot => `
        <div class="lot-card">
          <h3>${lot.title}</h3>
          <p>Цена: ${lot.price} $</p>
          <p>В наличии: ${lot.quantity}</p>
          <p>Продавец: ${lot.sellerId}</p>
          <button class="buy-btn" data-id="${lot.id}">Купить</button>
        </div>
      `).join('');

      // Обработка кнопок "Купить" - заполняем поле ID лота
      document.querySelectorAll('.buy-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const lotId = btn.dataset.id;
          document.getElementById('order-lot-id').value = lotId;
          document.getElementById('order-section').scrollIntoView({ behavior: 'smooth' });
        });
      });
    }
  } catch (err) {
    lotsContainer.innerHTML = '<p>Ошибка загрузки лотов</p>';
  }
}

// Создание заказа
orderForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (!token) {
    showMessage(document.getElementById('order-message'), 'Сначала войдите', 'error');
    return;
  }
  const lotId = document.getElementById('order-lot-id').value;
  try {
    const res = await fetch(`${API_BASE}/api/orders`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      },
      body: JSON.stringify({ lotId })
    });
    const data = await res.json();
    if (res.ok) {
      showMessage(document.getElementById('order-message'), `Заказ создан! ID: ${data.order.id}`, 'success');
      loadLots();
    } else {
      showMessage(document.getElementById('order-message'), data.error || 'Ошибка', 'error');
    }
  } catch (err) {
    showMessage(document.getElementById('order-message'), 'Ошибка сети', 'error');
  }
});

// Инициализация
setAuthState(null, null);
loadLots();
EOF

