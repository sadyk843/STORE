Добавим в тот же файл core/routes.ts полноценный заказ с холдом. Замени весь файл на этот (он включает создание лота и заказа с холдом и стейт-машиной):
bash

cat > ~/STORE/server/src/modules/core/routes.ts << 'EOF'
import { FastifyInstance } from 'fastify';
import { PrismaClient } from '@prisma/client';
import { authMiddleware } from '../../shared/middleware';

const prisma = new PrismaClient();

export async function coreRoutes(fastify: FastifyInstance) {
  // ----- Лоты -----
  fastify.post('/lots', { preHandler: authMiddleware }, async (request, reply) => {
    const { title, price, quantity, autoDelivery, autoDeliveryData } = request.body as {
      title: string;
      price: number;
      quantity: number;
      autoDelivery?: boolean;
      autoDeliveryData?: string;
    };
    const userId = request.user.id;

    const lot = await prisma.lot.create({
      data: {
        sellerId: userId,
        title,
        price,
        quantity,
        autoDelivery: autoDelivery || false,
        autoDeliveryData,
      },
    });
    reply.send(lot);
  });

  fastify.get('/lots', async () => {
    return await prisma.lot.findMany({ where: { status: 'ACTIVE' } });
  });

  fastify.get('/lots/:id', async (request) => {
    const { id } = request.params as { id: string };
    return await prisma.lot.findUnique({ where: { id } });
  });

  // ----- Заказы -----
  fastify.post('/orders', { preHandler: authMiddleware }, async (request, reply) => {
    const { lotId } = request.body as { lotId: string };
    const buyerId = request.user.id;

    // 1. Найти лот и продавца
    const lot = await prisma.lot.findUnique({
      where: { id: lotId },
      include: { seller: { include: { wallet: true } } },
    });
    if (!lot || lot.status !== 'ACTIVE') {
      return reply.status(404).send({ error: 'Lot not available' });
    }
    if (lot.sellerId === buyerId) {
      return reply.status(400).send({ error: 'Cannot buy your own lot' });
    }
    if (lot.quantity < 1) {
      return reply.status(400).send({ error: 'Out of stock' });
    }

    // 2. Проверить баланс покупателя
    const buyerWallet = await prisma.wallet.findUnique({ where: { userId: buyerId } });
    if (!buyerWallet || buyerWallet.balance < lot.price) {
      return reply.status(400).send({ error: 'Insufficient balance' });
    }

    // 3. Атомарная транзакция: списание, холд, создание заказа, уменьшение количества
    const result = await prisma.$transaction(async (tx) => {
      // 3a. Заморозить деньги покупателя
      await tx.wallet.update({
        where: { userId: buyerId },
        data: {
          balance: { decrement: lot.price },
          frozenBalance: { increment: lot.price },
        },
      });

      // 3b. Уменьшить количество лота
      const updatedLot = await tx.lot.update({
        where: { id: lotId },
        data: { quantity: { decrement: 1 } },
      });
      if (updatedLot.quantity === 0) {
        await tx.lot.update({ where: { id: lotId }, data: { status: 'SOLD_OUT' } });
      }

      // 3c. Создать заказ
      const commission = lot.price * 0.13;
      const sellerReceives = lot.price - commission;
      const order = await tx.order.create({
        data: {
          lotId,
          buyerId,
          sellerId: lot.sellerId,
          amount: lot.price,
          commission,
          sellerReceives,
          status: 'PAID_HOLD',
        },
      });

      // 3d. Создать холд
      const hold = await tx.hold.create({
        data: {
          orderId: order.id,
          amount: lot.price,
          expiresAt: new Date(Date.now() + 24 * 60 * 60 * 1000), // 24 часа
        },
      });

      // Обновить заказ ссылкой на холд
      await tx.order.update({
        where: { id: order.id },
        data: { holdId: hold.id },
      });

      return { order, hold };
    });

    reply.send(result);
  });

  // Подтверждение передачи (продавец)
  fastify.post('/orders/:id/confirm-transfer', { preHandler: authMiddleware }, async (request, reply) => {
    const { id } = request.params as { id: string };
    const userId = request.user.id;

    const order = await prisma.order.findUnique({ where: { id } });
    if (!order) return reply.status(404).send({ error: 'Order not found' });
    if (order.sellerId !== userId) return reply.status(403).send({ error: 'Forbidden' });
    if (order.status !== 'PAID_HOLD') return reply.status(400).send({ error: 'Invalid status' });

    const updated = await prisma.order.update({
      where: { id },
      data: { status: 'DELIVERED' },
    });
    // Обновить холд (можно продлить срок)
    await prisma.hold.update({
      where: { orderId: id },
      data: { expiresAt: new Date(Date.now() + 12 * 60 * 60 * 1000) }, // +12ч
    });
    reply.send(updated);
  });

  // Подтверждение получения (покупатель) – завершение сделки
  fastify.post('/orders/:id/confirm-receipt', { preHandler: authMiddleware }, async (request, reply) => {
    const { id } = request.params as { id: string };
    const userId = request.user.id;

    const order = await prisma.order.findUnique({
      where: { id },
      include: { lot: { include: { seller: { include: { wallet: true } } } } },
    });
    if (!order) return reply.status(404).send({ error: 'Order not found' });
    if (order.buyerId !== userId) return reply.status(403).send({ error: 'Forbidden' });
    if (order.status !== 'DELIVERED') return reply.status(400).send({ error: 'Invalid status' });

    // Атомарно: разморозка, перевод продавцу, комиссия, бонус покупателю
    const result = await prisma.$transaction(async (tx) => {
      // 1. Разморозить деньги покупателя (они уже заморожены, просто снять с frozenBalance)
      await tx.wallet.update({
        where: { userId: order.buyerId },
        data: { frozenBalance: { decrement: order.amount } },
      });

      // 2. Перевести продавцу сумму за вычетом комиссии
      await tx.wallet.update({
        where: { userId: order.sellerId },
        data: { balance: { increment: order.sellerReceives } },
      });

      // 3. Начислить кэшбек покупателю (2% от суммы)
      const cashback = order.amount * 0.02;
      await tx.wallet.update({
        where: { userId: order.buyerId },
        data: { bonusBalance: { increment: cashback } },
      });

      // 4. Завершить заказ
      const updatedOrder = await tx.order.update({
        where: { id },
        data: { status: 'COMPLETED', completedAt: new Date() },
      });

      // 5. Обновить холд
      await tx.hold.update({
        where: { orderId: id },
        data: { status: 'RELEASED' },
      });

      return updatedOrder;
    });

    reply.send(result);
  });
}
