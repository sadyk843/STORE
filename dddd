cat > ~/STORE/server/src/modules/core/routes.ts << 'EOF'
import { FastifyInstance } from 'fastify';
import { authMiddleware } from '../../shared/middleware';
import { createLot, updateLot, getLotsWithFilters } from './services';

export async function coreRoutes(fastify: FastifyInstance) {
  // Создание лота
  fastify.post('/lots', { preHandler: authMiddleware }, async (request, reply) => {
    const userId = (request as any).user.id;
    try {
      const lot = await createLot(userId, request.body);
      reply.send(lot);
    } catch (error: any) {
      reply.status(400).send({ error: error.message });
    }
  });

  // Обновление лота
  fastify.put('/lots/:id', { preHandler: authMiddleware }, async (request, reply) => {
    const { id } = request.params as { id: string };
    const userId = (request as any).user.id;
    try {
      const lot = await updateLot(id, userId, request.body);
      reply.send(lot);
    } catch (error: any) {
      reply.status(400).send({ error: error.message });
    }
  });

  // Получение лотов с фильтрами
  fastify.get('/lots', async (request, reply) => {
    try {
      const filters = request.query as any;
      const lots = await getLotsWithFilters(filters);
      reply.send(lots);
    } catch (error: any) {
      reply.status(400).send({ error: error.message });
    }
  });

  // Получение одного лота
  fastify.get('/lots/:id', async (request, reply) => {
    const { id } = request.params as { id: string };
    try {
      const lot = await prisma.lot.findUnique({ where: { id } });
      if (!lot) return reply.status(404).send({ error: 'Lot not found' });
      reply.send(lot);
    } catch (error: any) {
      reply.status(400).send({ error: error.message });
    }
  });

  // Остальные эндпоинты (заказы) – остаются без изменений
}
EOF

