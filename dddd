import { prisma } from '../../lib/prisma';
import { randomUUID } from 'crypto';

// ----- Адаптер для российских платежей (заглушка) -----
export class RuPaymentAdapter {
  static async createPayment(amount: number, userId: string): Promise<{ paymentId: string; status: 'success' | 'failed' }> {
    await new Promise(resolve => setTimeout(resolve, 500));
    const success = Math.random() < 0.95;
    return {
      paymentId: `ru_${randomUUID()}`,
      status: success ? 'success' : 'failed',
    };
  }
}

// ----- Получение баланса -----
export const getWalletInfo = async (userId: string) => {
  const wallet = await prisma.wallet.findUnique({ where: { userId } });
  if (!wallet) throw new Error('Wallet not found');
  return {
    rubBalance: wallet.rubBalance,
    usdtBalance: wallet.usdtBalance,
    frozenRub: wallet.frozenRub,
    frozenUsdt: wallet.frozenUsdt,
    bonusBalance: wallet.bonusBalance,
  };
};

// ----- Пополнение рублей (через российский агрегатор) -----
export const depositRub = async (userId: string, amount: number) => {
  if (amount <= 0) throw new Error('Amount must be positive');

  const paymentRequest = await prisma.paymentRequest.create({
    data: {
      userId,
      amount,
      currency: 'RUB',
      status: 'PENDING',
    },
  });

  const result = await RuPaymentAdapter.createPayment(amount, userId);

  const updated = await prisma.paymentRequest.update({
    where: { id: paymentRequest.id },
    data: {
      paymentId: result.paymentId,
      status: result.status === 'success' ? 'SUCCESS' : 'FAILED',
      completedAt: result.status === 'success' ? new Date() : undefined,
    },
  });

  if (result.status === 'success') {
    await prisma.$transaction(async (tx) => {
      // Пополняем рублёвый баланс
      await tx.wallet.update({
        where: { userId },
        data: { rubBalance: { increment: amount } },
      });
      await tx.transaction.create({
        data: {
          userId,
          type: 'DEPOSIT',
          amount,
          status: 'SUCCESS',
          reference: updated.id,
          description: `Пополнение RUB через RuPaymentAdapter (${result.paymentId})`,
        },
      });
    });
  }
  return updated;
};

// ----- Обмен RUB → USDT (по фиксированному курсу) -----
export const exchangeRubToUsdt = async (userId: string, rubAmount: number) => {
  if (rubAmount <= 0) throw new Error('Amount must be positive');

  // Заглушка курса – 1 USDT = 90 RUB
  const rate = 1 / 90;
  const usdtAmount = rubAmount * rate;

  const wallet = await prisma.wallet.findUnique({ where: { userId } });
  if (!wallet || wallet.rubBalance < rubAmount) {
    throw new Error('Insufficient RUB balance');
  }

  const exchange = await prisma.exchangeRequest.create({
    data: {
      userId,
      fromCurrency: 'RUB',
      toCurrency: 'USDT',
      amount: rubAmount,
      rate,
      resultAmount: usdtAmount,
      status: 'PENDING',
    },
  });

  await prisma.$transaction(async (tx) => {
    // Списываем рубли, зачисляем USDT
    await tx.wallet.update({
      where: { userId },
      data: {
        rubBalance: { decrement: rubAmount },
        usdtBalance: { increment: usdtAmount },
      },
    });
    await tx.exchangeRequest.update({
      where: { id: exchange.id },
      data: { status: 'COMPLETED', completedAt: new Date() },
    });
    await tx.transaction.create({
      data: {
        userId,
        type: 'DEPOSIT',
        amount: rubAmount,
        status: 'SUCCESS',
        description: `Обмен RUB → USDT по курсу ${rate}`,
      },
    });
  });

  return exchange;
};

// ----- Вывод USDT (заявка) -----
export const withdrawUsdt = async (userId: string, usdtAmount: number, address: string, network: string = 'TRC20') => {
  if (usdtAmount <= 0) throw new Error('Amount must be positive');
  if (!address || address.length < 10) throw new Error('Invalid address');

  const wallet = await prisma.wallet.findUnique({ where: { userId } });
  if (!wallet || wallet.usdtBalance < usdtAmount) throw new Error('Insufficient USDT balance');

  if (usdtAmount < 50) throw new Error('Minimum withdrawal is 50 USDT');

  const withdrawal = await prisma.withdrawalRequest.create({
    data: {
      userId,
      amount: usdtAmount,
      address,
      network,
      status: 'PENDING',
    },
  });

  // Здесь можно заморозить USDT, но пока оставим просто заявку
  return withdrawal;
};

