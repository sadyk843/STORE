}

// Отмена редактирования
lotCancelBtn.addEventListener('click', () => {
  editingLotId = null;
  lotForm.reset();
  lotFormTitle.textContent = 'Создать лот';
  lotSubmitBtn.textContent = 'Создать';
  lotCancelBtn.style.display = 'none';
  lotFormSection.style.display = 'none';
  document.getElementById('lot-id').value = '';
});

// Отправка формы (создание или обновление)
lotForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  const id = document.getElementById('lot-id').value;
  const title = document.getElementById('lot-title').value;
  const description = document.getElementById('lot-description').value;
  const price = parseFloat(document.getElementById('lot-price').value);
  const quantity = parseInt(document.getElementById('lot-quantity').value);
  const deliveryMethod = document.getElementById('lot-delivery-method').value;
  const autoDelivery = document.getElementById('lot-autodelivery').checked;
  const autoDeliveryData = document.getElementById('lot-autodelivery-data').value;
  const isActive = document.getElementById('lot-is-active').checked;
  const activationSchedule = document.getElementById('lot-activation-schedule').value;
  const excludedDates = document.getElementById('lot-excluded-dates').value.split(',').map(s => s.trim()).filter(Boolean);

  const payload = { title, description, price, quantity, deliveryMethod, autoDelivery, autoDeliveryData, isActive, activationSchedule, excludedDates };
  const url = id ? `${API_BASE}/api/lots/${id}` : `${API_BASE}/api/lots`;
  const method = id ? 'PUT' : 'POST';

  try {
    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (res.ok) {
      showMessage(document.getElementById('lot-form-message'), id ? 'Лот обновлён!' : 'Лот создан!', 'success');
      lotCancelBtn.click();
      loadLots();
    } else {
      showMessage(document.getElementById('lot-form-message'), data.error || 'Ошибка', 'error');
