cat >> ~/STORE/server/prisma/schema.prisma << 'EOF'

model CurrencyRate {
  id          String   @id @default(cuid())
  fromCurrency String  // например, "RUB"
  toCurrency   String  // например, "USDT"
  rate         Float   // курс RUB → USDT (сколько USDT дают за 1 RUB)
  updatedAt    DateTime @updatedAt
}

model ExchangeRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  fromCurrency  String
  toCurrency    String
  amount        Float    // сумма в fromCurrency
  rate          Float    // курс на момент обмена
  resultAmount  Float    // сколько получится в toCurrency
  status        ExchangeStatus @default(PENDING)
  createdAt     DateTime @default(now())
  completedAt   DateTime?
}

enum ExchangeStatus {
  PENDING
  COMPLETED
  FAILED
}
