const API_BASE = 'http://localhost:3000';
let token = null;
let userId = null;
let editingLotId = null;

// DOM элементы (опущены для краткости, но они есть)
// Функции showMessage, setAuthState – остаются

// ===== ЛОТЫ =====
const lotForm = document.getElementById('lot-form');
const lotFormSection = document.getElementById('lot-form-section');
const lotFormTitle = document.getElementById('lot-form-title');
const lotSubmitBtn = document.getElementById('lot-submit-btn');
const lotCancelBtn = document.getElementById('lot-cancel-btn');

const filtersForm = document.getElementById('filters-form');
const lotsContainer = document.getElementById('lots-container');

// Загрузка лотов с фильтрами
async function loadLots() {
  const params = new URLSearchParams();
  const minPrice = document.getElementById('filter-min-price').value;
  const maxPrice = document.getElementById('filter-max-price').value;
  const minQuantity = document.getElementById('filter-min-quantity').value;
  const maxQuantity = document.getElementById('filter-max-quantity').value;
  const autoDelivery = document.getElementById('filter-autodelivery').checked;
  const isActive = document.getElementById('filter-active').checked;
  const search = document.getElementById('filter-search').value;
  if (minPrice) params.append('minPrice', minPrice);
  if (maxPrice) params.append('maxPrice', maxPrice);
  if (minQuantity) params.append('minQuantity', minQuantity);
  if (maxQuantity) params.append('maxQuantity', maxQuantity);
  if (autoDelivery) params.append('autoDelivery', 'true');
  if (isActive !== undefined) params.append('isActive', isActive);
  if (search) params.append('search', search);

  try {
    const res = await fetch(`${API_BASE}/api/lots?${params.toString()}`);
    const data = await res.json();
    if (res.ok) {
      if (data.length === 0) {
        lotsContainer.innerHTML = '<p>Нет лотов по заданным фильтрам</p>';
        return;
      }
      lotsContainer.innerHTML = data.map(lot => `
        <div class="lot-card" data-id="${lot.id}">
          <div class="lot-header">
            <span class="lot-status ${lot.isActive ? 'active' : 'inactive'}">${lot.isActive ? 'Активен' : 'Неактивен'}</span>
            ${lot.sellerId === userId ? `<button class="edit-btn" data-id="${lot.id}">Настроить</button>` : ''}
          </div>
          <h3>${lot.title}</h3>
          <p>${lot.description || ''}</p>
          <p>Цена: ${lot.price} $</p>
          <p>Количество: ${lot.quantity}</p>
          <p>Способ выдачи: ${lot.deliveryMethod || 'Не указан'}</p>
          ${lot.autoDelivery ? `<div class="auto-delivery-badge">Автовыдача</div>` : ''}
          ${lot.activationSchedule ? `<p>Расписание: ${lot.activationSchedule}</p>` : ''}
          <button class="buy-btn" data-id="${lot.id}">Купить</button>
        </div>
      `).join('');

      // Обработчики кнопок
      document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.id;
          openEditForm(id);
        });
      });
      document.querySelectorAll('.buy-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.getElementById('order-lot-id').value = btn.dataset.id;
          document.getElementById('order-section').scrollIntoView({ behavior: 'smooth' });
        });
      });
    } else {
      lotsContainer.innerHTML = '<p>Ошибка загрузки лотов</p>';
    }
  } catch (err) {
    lotsContainer.innerHTML = '<p>Ошибка сети</p>';
  }
}

// Открыть форму редактирования
async function openEditForm(lotId) {
  try {
    const res = await fetch(`${API_BASE}/api/lots/${lotId}`, {
      headers: { 'Authorization': `Bearer ${token}` }
    });
    const lot = await res.json();
    if (res.ok) {
      editingLotId = lotId;
      document.getElementById('lot-id').value = lot.id;
      document.getElementById('lot-title').value = lot.title;
      document.getElementById('lot-description').value = lot.description || '';
      document.getElementById('lot-price').value = lot.price;
      document.getElementById('lot-quantity').value = lot.quantity;
      document.getElementById('lot-delivery-method').value = lot.deliveryMethod || 'Автоматически';
      document.getElementById('lot-autodelivery').checked = lot.autoDelivery;
      document.getElementById('lot-autodelivery-data').value = lot.autoDeliveryData || '';
      document.getElementById('lot-is-active').checked = lot.isActive;
      document.getElementById('lot-activation-schedule').value = lot.activationSchedule || '';
      document.getElementById('lot-excluded-dates').value = lot.excludedDates ? lot.excludedDates.join(', ') : '';
      lotFormTitle.textContent = 'Редактировать лот';
      lotSubmitBtn.textContent = 'Сохранить';
      lotCancelBtn.style.display = 'inline-block';
      lotFormSection.style.display = 'block';
      lotFormSection.scrollIntoView({ behavior: 'smooth' });
