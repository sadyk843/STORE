cat > ~/STORE/server/src/modules/payment/routes.ts << 'EOF'
import { FastifyInstance } from 'fastify';
import { authMiddleware } from '../../shared/middleware';
import {
  getWalletInfo,
  depositRub,
  exchangeRubToUsdt,
  withdrawUsdt,
  getExchangeRate,
  handleRuWebhook,
} from './services';

export async function paymentRoutes(fastify: FastifyInstance) {
  // Получить баланс
  fastify.get('/wallet', { preHandler: authMiddleware }, async (request, reply) => {
    const userId = (request as any).user.id;
    try {
      const data = await getWalletInfo(userId);
      reply.send(data);
    } catch (error: any) {
      reply.status(400).send({ error: error.message });
    }
  });

  // Пополнение рублей
  fastify.post('/deposit-rub', { preHandler: authMiddleware }, async (request, reply) => {
    const { amount } = request.body as { amount: number };
    const userId = (request as any).user.id;
    try {
      const result = await depositRub(userId, amount);
      reply.send(result);
    } catch (error: any) {
      reply.status(400).send({ error: error.message });
    }
  });

  // Обмен RUB → USDT
  fastify.post('/exchange', { preHandler: authMiddleware }, async (request, reply) => {
    const { rubAmount } = request.body as { rubAmount: number };
    const userId = (request as any).user.id;
    try {
      const result = await exchangeRubToUsdt(userId, rubAmount);
      reply.send(result);
    } catch (error: any) {
      reply.status(400).send({ error: error.message });
    }
  });

  // Вывод USDT
  fastify.post('/withdraw-usdt', { preHandler: authMiddleware }, async (request, reply) => {
    const { amount, address, network } = request.body as {
      amount: number;
      address: string;
      network?: string;
    };
    const userId = (request as any).user.id;
    try {
      const result = await withdrawUsdt(userId, amount, address, network);
      reply.send(result);
    } catch (error: any) {
      reply.status(400).send({ error: error.message });
    }
  });

  // Получить курс RUB→USDT
  fastify.get('/rate', async (request, reply) => {
    try {
      const rate = await getExchangeRate();
      reply.send(rate);
    } catch (error: any) {
      reply.status(400).send({ error: error.message });
    }
  });

  // Вебхук для российского агрегатора (публичный)
  fastify.post('/webhook-ru', async (request, reply) => {
    try {
      const result = await handleRuWebhook(request.body);
      reply.send(result);
    } catch (error: any) {
      reply.status(400).send({ error: error.message });
    }
  });
}
EOF

