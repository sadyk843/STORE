  sellerId        String
  seller          User     @relation(fields: [sellerId], references: [id])
  title           String
  description     String?  // описание
  price           Float
  quantity        Int
  autoDelivery    Boolean  @default(false)
  autoDeliveryData String? // данные для автовыдачи
  deliveryMethod  String?  // "Автоматически", "Вручную", "Смешанный"
  isActive        Boolean  @default(true) // активен ли лот
  activationSchedule String? // cron-выражение или время активации (например, "daily 15:00")
  excludedDates   Json?    // массив дат "YYYY-MM-DD", когда не активировать
  status          LotStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          Order[]
}

