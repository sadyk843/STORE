// Загрузка лотов с фильтрами
async function loadLots() {
  const params = new URLSearchParams();
  const minPrice = document.getElementById('filter-min-price').value;
  const maxPrice = document.getElementById('filter-max-price').value;
  const minQuantity = document.getElementById('filter-min-quantity').value;
  const maxQuantity = document.getElementById('filter-max-quantity').value;
  const autoDelivery = document.getElementById('filter-autodelivery').checked;
  const isActive = document.getElementById('filter-active').checked;
  const search = document.getElementById('filter-search').value;
  if (minPrice) params.append('minPrice', minPrice);
  if (maxPrice) params.append('maxPrice', maxPrice);
  if (minQuantity) params.append('minQuantity', minQuantity);
  if (maxQuantity) params.append('maxQuantity', maxQuantity);
  if (autoDelivery) params.append('autoDelivery', 'true');
  if (isActive !== undefined) params.append('isActive', isActive);
  if (search) params.append('search', search);

  try {
    const res = await fetch(`${API_BASE}/api/lots?${params.toString()}`);
    const data = await res.json();
    if (res.ok) {
      if (data.length === 0) {
        lotsContainer.innerHTML = '<p>Нет лотов по заданным фильтрам</p>';
        return;
      }
      lotsContainer.innerHTML = data.map(lot => `
        <div class="lot-card" data-id="${lot.id}">
          <div class="lot-header">
            <span class="lot-status ${lot.isActive ? 'active' : 'inactive'}">${lot.isActive ? 'Активен' : 'Неактивен'}</span>
            ${lot.sellerId === userId ? `<button class="edit-btn" data-id="${lot.id}">Настроить</button>` : ''}
          </div>
          <h3>${lot.title}</h3>
          <p>${lot.description || ''}</p>
          <p>Цена: ${lot.price} $</p>
          <p>Количество: ${lot.quantity}</p>
          <p>Способ выдачи: ${lot.deliveryMethod || 'Не указан'}</p>
          ${lot.autoDelivery ? `<div class="auto-delivery-badge">Автовыдача</div>` : ''}
          ${lot.activationSchedule ? `<p>Расписание: ${lot.activationSchedule}</p>` : ''}
          <button class="buy-btn" data-id="${lot.id}">Купить</button>
        </div>
      `).join('');

      document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          openEditForm(btn.dataset.id);
        });
      });
      document.querySelectorAll('.buy-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.getElementById('order-lot-id').value = btn.dataset.id;
          document.getElementById('order-section').scrollIntoView({ behavior: 'smooth' });
        });
      });
    } else {
      lotsContainer.innerHTML = '<p>Ошибка загрузки лотов</p>';
    }
  } catch (err) {
    lotsContainer.innerHTML = '<p>Ошибка сети</p>';
  }
}

